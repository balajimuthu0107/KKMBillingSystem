# =======================================================
# KKM Sea Foodz Billing System - Backend Environment Config
# =======================================================

PORT=8080

# OPTION 1 (Recommended): Place your downloaded serviceAccountKey.json
# directly in the backend/ folder, or specify its path here:
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# OPTION 2: Individual Firebase Service Account credentials
# (Copy from your Firebase Console -> Project Settings -> Service Accounts)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OPTION 3: Full JSON string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
